# Copy to .env (it is git-ignored) or export these in your shell.

# LLM provider: groq (default) or anthropic. Set the key for the one you use.
GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# ATLAS_LLM_PROVIDER=groq

# Optional overrides (empty = provider defaults).
# groq:      openai/gpt-oss-120b / openai/gpt-oss-20b / judge qwen/qwen3.8-27b
# anthropic: claude-opus-4-8 / claude-haiku-4-5 / judge claude-opus-4-8
# ATLAS_MODEL=
# ATLAS_FAST_MODEL=
# ATLAS_JUDGE_MODEL=

# ATLAS_EMBEDDING_BACKEND=auto        # auto | sentence-transformers | hashing
# ATLAS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# ATLAS_INDEX_DIR=.atlas_index
