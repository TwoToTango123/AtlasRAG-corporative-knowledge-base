# Copy to .env (or just export these in your shell) before running AtlasRAG.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# ATLAS_MODEL=claude-opus-4-8
# ATLAS_FAST_MODEL=claude-haiku-4-5
# ATLAS_EMBEDDING_BACKEND=auto        # auto | sentence-transformers | hashing
# ATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ATLAS_INDEX_DIR=.atlas_index
